# -------------------------
# Environment metadata
# -------------------------
ENVIRONMENT=DEV
API_BASE_URL=https://dev.api.myapp.com
API_TIMEOUT=30

# -------------------------
# Database (non-secret)
# -------------------------
DB_HOST=dev-db.myapp.local
DB_NAME=myapp
DB_USER=dev_user

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=Debug
LOG_INCLUDE_SCOPES=true

# -------------------------
# External service URLs
# -------------------------
IMPORTER_URL=https://dev.importer.myapp.com
CHATBOT_URL=https://dev.chatbot.myapp.com

# -------------------------
# Authentication (non-secret)
# -------------------------
AUTH_AUTHORITY=https://login.microsoftonline.com/mytenant
AUTH_CLIENT_ID=11111111-2222-3333-4444-555555555555

# -------------------------
# Key Vaults (multiple)
# -------------------------
KEYVAULTS=my-kv,my-kv2

# Secret references:
# Format: SECRET_NAME=vaultName:secretName
SECRET_DB_PASSWORD=my-kv:DB-PASSWORD
SECRET_API_KEY=my-kv2:API-KEY

# -------------------------
# Azure DevOps variable group
# -------------------------
AZDO_ORG=myorg
AZDO_PROJECT=myproject
AZDO_GROUP=SharedConfig
AZDO_PAT=env:AZDO_PAT   # or put PAT directly if you prefer

# -------------------------
# Feature flags (from DevOps group)
# These will be overridden by DevOps variable group values
# but defaults are useful for local fallback
# -------------------------
FEATURE_FLAG_NEW_UI=false
FEATURE_FLAG_BETA=false
